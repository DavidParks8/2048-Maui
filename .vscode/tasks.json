{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: TwentyFortyEight.Maui (windows)",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "build",
        "apps/twenty-forty-eight/src/TwentyFortyEight.Maui/TwentyFortyEight.Maui.csproj",
        "-f",
        "net10.0-windows10.0.19041.0"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: TwentyFortyEight.Maui (maccatalyst)",
      "command": "dotnet",
      "type": "shell",
      "args": [
        "build",
        "apps/twenty-forty-eight/src/TwentyFortyEight.Maui/TwentyFortyEight.Maui.csproj",
        "-f",
        "net10.0-maccatalyst",
        "-c",
        "Debug"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build: TwentyFortyEight.Maui (android)",
      "command": "dotnet",
