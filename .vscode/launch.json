{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Godot: Launch",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build: Godot",
      "program": "/Applications/Godot_mono.app/Contents/MacOS/Godot",
      "args": [
        "--path",
        "${workspaceFolder}/src/TwentyFortyEight.Godot"
      ],
      "cwd": "${workspaceFolder}/src/TwentyFortyEight.Godot",
      "stopAtEntry": false,
      "console": "internalConsole"
    },
    {
      "name": "Godot: Attach",
      "type": "coreclr",
      "request": "attach",
      "processName": "Godot"
    },
    {
      "name": ".NET Meteor Debugger",
      "type": "dotnet-meteor.debugger",
      "request": "launch",
      "preLaunchTask": "dotnet-meteor: Build"
    },
    {
      "name": ".NET MAUI Debug",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false,

      "osx": {
        "preLaunchTask": "build: TwentyFortyEight.Maui (maccatalyst)",
        "args": [
          "run",
          "--project",
          "src/TwentyFortyEight.Maui/TwentyFortyEight.Maui.csproj",
          "--framework",
          "net10.0-maccatalyst",
          "--no-build"
        ]
      },
      "windows": {
        "preLaunchTask": "build: TwentyFortyEight.Maui (windows)",
        "args": [
          "run",
          "--project",
          "src/TwentyFortyEight.Maui/TwentyFortyEight.Maui.csproj",
          "--framework",
          "net10.0-windows10.0.19041.0",
          "--no-build"
        ]
      }
    },
    {
      "name": ".NET MAUI Android Debug",
      "type": "coreclr",
      "request": "launch",
      "program": "dotnet",
      "env": {
        "MAUI_TARGET_PLATFORM": "android"
      },
      "args": [
        "run",
        "--project",
        "src/TwentyFortyEight.Maui/TwentyFortyEight.Maui.csproj",
        "--framework",
        "net10.0-android"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
