<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:components="clr-namespace:TwentyFortyEight.Maui.Components"
        x:Class="TwentyFortyEight.Maui.Components.GlassToast"
        x:Name="ToastBorder"
        HorizontalOptions="Center"
        VerticalOptions="End"
        Margin="16,0,16,120"
        Padding="0"
        StrokeThickness="0"
        StrokeShape="RoundRectangle 25"
        components:LiquidGlass.EffectType="Clear"
        components:LiquidGlass.CornerRadius="25"
        components:LiquidGlass.EnableShadowEffect="True"
        Opacity="0">
    <Border.BackgroundColor>
        <OnPlatform x:TypeArguments="Color">
            <!-- Apple platforms use transparent because LiquidGlass provides the background -->
            <On Platform="iOS, MacCatalyst" Value="Transparent" />
            <!-- Non-Apple platforms need a visible background -->
            <On Platform="Android, WinUI" Value="{AppThemeBinding Light={StaticResource NativeSettingsCellBackgroundLight}, Dark={StaticResource NativeSettingsCellBackgroundDark}}" />
        </OnPlatform>
    </Border.BackgroundColor>
    <Grid Padding="28,14">
        <Label x:Name="MessageLabel"
               FontSize="15"
               LineBreakMode="NoWrap"
               TextColor="{AppThemeBinding Light={StaticResource NativeTextPrimaryLight}, Dark={StaticResource NativeTextPrimaryDark}}"
               HorizontalOptions="Center"
               HorizontalTextAlignment="Center"
               VerticalOptions="Center"
               VerticalTextAlignment="Center" />
    </Grid>
</Border>
