<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:components="clr-namespace:TwentyFortyEight.Maui.Components"
             xmlns:strings="clr-namespace:TwentyFortyEight.Maui.Resources.Strings"
             x:Class="TwentyFortyEight.Maui.Components.ModeSelectionView"
             x:Name="RootView">
    <VerticalStackLayout Spacing="16" Padding="0,4,0,0">
        <!-- Game Mode Picker Section -->
        <VerticalStackLayout Spacing="8">
            <Label Text="{x:Static strings:AppStrings.GameMode}"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource NativeTextTertiaryLight}, Dark={StaticResource NativeTextTertiaryDark}}"
                   Margin="8,0,0,0" />

            <Border StrokeThickness="1"
                    StrokeShape="RoundRectangle 22"
                    Background="{AppThemeBinding Light={StaticResource ModalBackgroundLight}, Dark={StaticResource ModalBackgroundDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    components:LiquidGlass.EffectType="Regular"
                    components:LiquidGlass.EnableShadowEffect="False"
                    components:LiquidGlass.CornerRadius="22">
                <FlexLayout Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="SpaceEvenly"
                        AlignContent="Start"
                        AlignItems="Start"
                        Padding="2">
                    <Border x:Name="ModernTab"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            Padding="0"
                        Margin="0,0,0,1">
                        <Button x:Name="ModernTabButton"
                                Text="{x:Static strings:AppStrings.ModernMode}"
                                FontSize="15"
                                FontAttributes="Bold"
                                Padding="8,6"
                                LineBreakMode="NoWrap"
                                Background="Transparent"
                                Clicked="OnModernModeClicked" />
                    </Border>

                    <Border x:Name="ClassicTab"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            Padding="0"
                        Margin="0,0,0,1">
                        <Button x:Name="ClassicTabButton"
                                Text="{x:Static strings:AppStrings.ClassicMode}"
                                FontSize="15"
                                FontAttributes="Bold"
                                Padding="8,6"
                                LineBreakMode="NoWrap"
                                Background="Transparent"
                                Clicked="OnClassicModeClicked" />
                    </Border>

                    <Border x:Name="WalltastrophyTab"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 20"
                            Padding="0"
                        Margin="0,0,0,1">
                        <Button x:Name="WalltastrophyTabButton"
                                Text="{x:Static strings:AppStrings.WalltastrophyMode}"
                                FontSize="15"
                                FontAttributes="Bold"
                                Padding="8,6"
                                LineBreakMode="NoWrap"
                                Background="Transparent"
                                Clicked="OnWalltastrophyModeClicked" />
                    </Border>
                </FlexLayout>
            </Border>

            <!-- Mode Description Text -->
            <Label x:Name="ModeDescriptionLabel"
                   FontSize="15"
                   LineHeight="1.3"
                   TextColor="{AppThemeBinding Light={StaticResource NativeTextSecondaryLight}, Dark={StaticResource NativeTextSecondaryDark}}" />
        </VerticalStackLayout>

        <!-- Board Size Picker Section -->
        <VerticalStackLayout Spacing="8">
            <Label Text="{x:Static strings:AppStrings.BoardSize}"
                   FontSize="13"
                   TextColor="{AppThemeBinding Light={StaticResource NativeTextTertiaryLight}, Dark={StaticResource NativeTextTertiaryDark}}"
                   Margin="8,0,0,0" />
            
            <ContentView x:Name="SizePickerContainer" />
        </VerticalStackLayout>

        <!-- Helper Text -->
        <Label x:Name="HelperTextLabel"
               Text="{x:Static strings:AppStrings.ModeHelperText}"
               FontSize="15"
               LineHeight="1.3"
               TextColor="{AppThemeBinding Light={StaticResource NativeTextSecondaryLight}, Dark={StaticResource NativeTextSecondaryDark}}" />

        <!-- Action Button -->
        <Button x:Name="PlayButton"
                Text="{x:Static strings:AppStrings.Play}"
                CornerRadius="22"
                HeightRequest="50"
                FontSize="17"
                FontAttributes="Bold"
                Clicked="OnPlayClicked"
                Margin="0,8,0,0" />
    </VerticalStackLayout>
</ContentView>
