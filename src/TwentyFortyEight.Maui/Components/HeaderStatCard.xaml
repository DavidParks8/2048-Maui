<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TwentyFortyEight.Maui.Components"
             xmlns:converters="clr-namespace:TwentyFortyEight.Maui.Converters"
             x:Class="TwentyFortyEight.Maui.Components.HeaderStatCard"
             x:DataType="local:HeaderStatCard"
             x:Name="this">

    <ContentView.Resources>
        <converters:ValueLengthToFontSizeConverter x:Key="ValueLengthToFontSizeConverter" 
                                                    BaseFontSize="20" 
                                                    MinFontSize="12" 
                                                    ScaleThreshold="4" />
    </ContentView.Resources>

    <Grid MinimumWidthRequest="90">
        <Border Background="{AppThemeBinding Light={StaticResource GamePanelBackgroundLight}, Dark={StaticResource GamePanelBackgroundDark}}"
                Stroke="Transparent"
                StrokeThickness="0"
                Padding="20,10"
                HeightRequest="60"
                StrokeShape="RoundRectangle 5">
            <VerticalStackLayout Spacing="0">
                <Label Text="{Binding Title, Source={x:Reference this}}"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#eee4da, Dark=#cdc1b4}"
                       HorizontalOptions="Center"
                       LineBreakMode="NoWrap" />
                <Label Text="{Binding Value, Source={x:Reference this}}"
                       FontSize="{Binding Value, Source={x:Reference this}, Converter={StaticResource ValueLengthToFontSizeConverter}}"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       LineBreakMode="NoWrap"
                       SemanticProperties.Description="{Binding ValueDescription, Source={x:Reference this}}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
