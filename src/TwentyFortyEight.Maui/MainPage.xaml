<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TwentyFortyEight.ViewModels;assembly=TwentyFortyEight.ViewModels"
             xmlns:components="clr-namespace:TwentyFortyEight.Maui.Components"
             xmlns:behaviors="clr-namespace:TwentyFortyEight.Maui.Behaviors"
             xmlns:converters="clr-namespace:TwentyFortyEight.Maui.Converters"
             xmlns:core="clr-namespace:TwentyFortyEight.Core;assembly=TwentyFortyEight.Core"
             xmlns:strings="clr-namespace:TwentyFortyEight.Maui.Resources.Strings"
             xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
             x:Class="TwentyFortyEight.Maui.MainPage"
             x:DataType="local:GameViewModel"
             Background="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
             >

    <ContentPage.Resources>
        <converters:FontSizeScaleConverter x:Key="FontSizeScaleConverter" />
        <converters:BoolToOpacityConverter x:Key="BoolToOpacityConverter" />
        <converters:GameModeToDisplayNameConverter x:Key="GameModeToDisplayNameConverter" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem
            x:Name="ToolbarNewGameButton"
            AutomationId="ToolbarNewGameButton"
            Text="{x:Static strings:AppStrings.NewGame}"
            Command="{Binding NewGameCommand}"
            Order="Primary"
            Priority="0" />
        <ToolbarItem
            x:Name="ToolbarModeButton"
            AutomationId="ToolbarModeButton"
            Text="{x:Static strings:AppStrings.ModeTitle}"
            Clicked="OnModeClicked"
            Order="Primary"
            Priority="1" />
        <ToolbarItem
            x:Name="ToolbarLeaderboardButton"
            AutomationId="ToolbarLeaderboardButton"
            Text="{x:Static strings:AppStrings.LeaderboardToolbarText}"
            Command="{Binding ShowLeaderboardCommand}"
            Order="Secondary"
            Priority="0" />
        <ToolbarItem
            x:Name="ToolbarAchievementsButton"
            AutomationId="ToolbarAchievementsButton"
            Text="{x:Static strings:AppStrings.AchievementsToolbarText}"
            Command="{Binding ShowAchievementsCommand}"
            Order="Secondary"
            Priority="1" />
        <ToolbarItem
            x:Name="ToolbarStatisticsButton"
            AutomationId="ToolbarStatisticsButton"
            Text="{x:Static strings:AppStrings.StatisticsToolbarText}"
            Command="{Binding OpenStatsCommand}"
            Order="Secondary"
            Priority="2" />
        <ToolbarItem
            x:Name="ToolbarSettingsButton"
            AutomationId="ToolbarSettingsButton"
            Text="{x:Static strings:AppStrings.Settings}"
            Command="{Binding OpenSettingsCommand}"
            Order="Secondary"
            Priority="3" />
        <ToolbarItem
            x:Name="ToolbarHowToPlayButton"
            AutomationId="ToolbarHowToPlayButton"
            Text="{x:Static strings:AppStrings.HowToPlay}"
            Command="{Binding ShowHowToPlayCommand}"
            Order="Secondary"
            Priority="4" />
        <ToolbarItem
            x:Name="ToolbarAboutButton"
            AutomationId="ToolbarAboutButton"
            Text="{x:Static strings:AppStrings.About}"
            Command="{Binding OpenAboutCommand}"
            Order="Secondary"
            Priority="5" />
        <ToolbarItem
            x:Name="ToolbarCoachButton"
            AutomationId="ToolbarCoachButton"
            Text="{x:Static strings:AppStrings.Coach}"
            Command="{Binding ToggleCoachCommand}"
            Order="Secondary"
            Priority="6" />
    </ContentPage.ToolbarItems>

    <Grid>
        <Grid x:Name="RootLayout" Padding="16" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

        <!-- Header with Title and Score -->
        <Grid x:Name="HeaderGrid" Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <components:HeaderStatCard Grid.Column="0"
                                      Margin="0,0,10,0"
                                      Title="{x:Static strings:AppStrings.Size}"
                                      Value="{Binding BoardSize, StringFormat='{}{0}x{0}'}"
                                      ValueDescription="{x:Static strings:AppStrings.BoardSize}" />

            <components:HeaderStatCard Grid.Column="2"
                                      Margin="10,0"
                                      Title="{x:Static strings:AppStrings.Score}"
                                      Value="{Binding Score}"
                                      ValueDescription="{x:Static strings:AppStrings.CurrentScoreDescription}" />

            <components:HeaderStatCard Grid.Column="3"
                                      Title="{x:Static strings:AppStrings.Best}"
                                      Value="{Binding BestScore}"
                                      ValueDescription="{x:Static strings:AppStrings.BestScoreDescription}" />
        </Grid>

        <!-- Game Board with attached mode indicator -->
        <Grid Grid.Row="2"
              HorizontalOptions="Center"
              VerticalOptions="Center">
            
            <Border x:Name="BoardContainer"
                    Background="{AppThemeBinding Light={StaticResource GamePanelBackgroundLight}, Dark={StaticResource GamePanelBackgroundDark}}"
                    Stroke="Transparent"
                    StrokeThickness="0"
                    Padding="10"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="820"
                    MaximumHeightRequest="820"
                    StrokeShape="RoundRectangle 10"
                    AutomationProperties.IsInAccessibleTree="True"
                    SemanticProperties.Description="{x:Static strings:AppStrings.GameBoardDescription}">

                <Border.Behaviors>
                    <behaviors:RippleBehavior />
                    <behaviors:VictoryOverlayBehavior />
                </Border.Behaviors>

                <Grid>
                    <!-- Grid for tiles - rows and columns are generated dynamically in code-behind -->
                    <Grid x:Name="GameBoard"
                          ColumnSpacing="10"
                          RowSpacing="10"
                          SemanticProperties.Description="{x:Static strings:AppStrings.GameBoardDescription}">
                        <!-- Tiles will be added programmatically in code-behind -->
                        <!-- WidthRequest and HeightRequest are set dynamically in OnSizeAllocated for responsive scaling -->
                    </Grid>

                    <!-- Walltastrophy wall overlay (fills the divider spacing between cells) -->
                    <AbsoluteLayout x:Name="WallOverlayLayer"
                                    InputTransparent="True"
                                    ZIndex="5" />

                    <!-- Coach nudge (appears only when Coach is off and user is struggling) -->
                    <components:CoachNudgeBanner
                        x:Name="CoachNudgeContainer"
                        IsVisible="{Binding IsCoachNudgeVisible}"
                        DismissCommand="{Binding DismissCoachNudgeCommand}"
                        EnableCoachCommand="{Binding EnableCoachFromNudgeCommand}" />

                    <!-- Coach animated swipe hint -->
                    <components:CoachSwipeHintOverlay
                        IsActive="{Binding IsCoachSuggestionVisible}"
                        Direction="{Binding CoachSuggestedDirection}"
                        Reason="{Binding CoachPrimaryReason}"
                        MoveCounter="{Binding CoachMoveCounter}"
                        InputTransparent="True"
                        ZIndex="10" />
                </Grid>
            </Border>

            <!-- Mode indicator pill attached to top of board -->
            <Grid x:Name="GameModeIndicator"
                  InputTransparent="True"
                  ZIndex="20"
                  HorizontalOptions="Center"
                  VerticalOptions="Start"
                  TranslationY="-36">
                
                <!-- Main pill body -->
                <Border Padding="24,8,24,8"
                        Background="{AppThemeBinding Light={StaticResource GamePanelBackgroundLight}, Dark={StaticResource GamePanelBackgroundDark}}"
                        Stroke="Transparent"
                        StrokeShape="RoundRectangle 20,20,0,0"
                        HorizontalOptions="Center"
                        VerticalOptions="Start">
                    <Label Text="{Binding GameMode, Converter={StaticResource GameModeToDisplayNameConverter}}"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center" />
                </Border>
                
                <!-- Left inverted corner: gray square with black curve on top -->
                <Grid WidthRequest="10" HeightRequest="10"
                      HorizontalOptions="Start" VerticalOptions="End"
                      TranslationX="-9"
                      TranslationY="-1">
                    <Border Background="{AppThemeBinding Light={StaticResource GamePanelBackgroundLight}, Dark={StaticResource GamePanelBackgroundDark}}"
                            Stroke="Transparent"
                            StrokeThickness="0" />
                    <Border Background="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 0,0,0,10" />
                </Grid>
                
                <!-- Right inverted corner: gray square with black curve on top -->
                <Grid WidthRequest="10" HeightRequest="10"
                      HorizontalOptions="End" VerticalOptions="End"
                      TranslationX="10"
                      TranslationY="-1">
                    <Border Background="{AppThemeBinding Light={StaticResource GamePanelBackgroundLight}, Dark={StaticResource GamePanelBackgroundDark}}"
                            Stroke="Transparent"
                            StrokeThickness="0" />
                    <Border Background="{AppThemeBinding Light={StaticResource PageBackgroundLight}, Dark={StaticResource PageBackgroundDark}}"
                            Stroke="Transparent"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 0,0,10,0" />
                </Grid>
            </Grid>
        </Grid>
        <Grid Grid.Row="3">
            <!-- Movement buttons (centered with board) -->
            <HorizontalStackLayout x:Name="MoveButtonsContainer"
                           Spacing="8"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           MaximumWidthRequest="820">
                <!-- Left -->
                <Border x:Name="MoveLeftContainer"
                    WidthRequest="56"
                        HeightRequest="56"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 28"
                        Background="{AppThemeBinding Light={StaticResource ModalBackgroundLight}, Dark={StaticResource ModalBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        components:LiquidGlass.EffectType="Clear"
                        components:LiquidGlass.CornerRadius="28">
                    <components:IconButton AutomationId="MoveLeftButton"
                                           Icon="←"
                                           ButtonText=""
                                           Command="{Binding MoveCommand}"
                                           CommandParameter="{x:Static core:Direction.Left}"
                                           ButtonSize="56"
                                           SemanticProperties.Description="{x:Static strings:AppStrings.MoveLeftDescription}" />
                </Border>

                <!-- Up -->
                <Border x:Name="MoveUpContainer"
                        WidthRequest="56"
                        HeightRequest="56"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 28"
                        Background="{AppThemeBinding Light={StaticResource ModalBackgroundLight}, Dark={StaticResource ModalBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        components:LiquidGlass.EffectType="Clear"
                        components:LiquidGlass.CornerRadius="28">
                    <components:IconButton AutomationId="MoveUpButton"
                                           Icon="↑"
                                           ButtonText=""
                                           Command="{Binding MoveCommand}"
                                           CommandParameter="{x:Static core:Direction.Up}"
                                           ButtonSize="56"
                                           SemanticProperties.Description="{x:Static strings:AppStrings.MoveUpDescription}" />
                </Border>

                <!-- Down -->
                <Border x:Name="MoveDownContainer"
                        WidthRequest="56"
                        HeightRequest="56"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 28"
                        Background="{AppThemeBinding Light={StaticResource ModalBackgroundLight}, Dark={StaticResource ModalBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        components:LiquidGlass.EffectType="Clear"
                        components:LiquidGlass.CornerRadius="28">
                    <components:IconButton AutomationId="MoveDownButton"
                                           Icon="↓"
                                           ButtonText=""
                                           Command="{Binding MoveCommand}"
                                           CommandParameter="{x:Static core:Direction.Down}"
                                           ButtonSize="56"
                                           SemanticProperties.Description="{x:Static strings:AppStrings.MoveDownDescription}" />
                </Border>

                <!-- Right -->
                <Border x:Name="MoveRightContainer"
                        WidthRequest="56"
                        HeightRequest="56"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 28"
                        Background="{AppThemeBinding Light={StaticResource ModalBackgroundLight}, Dark={StaticResource ModalBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        components:LiquidGlass.EffectType="Clear"
                        components:LiquidGlass.CornerRadius="28">
                    <components:IconButton AutomationId="MoveRightButton"
                                           Icon="→"
                                           ButtonText=""
                                           Command="{Binding MoveCommand}"
                                           CommandParameter="{x:Static core:Direction.Right}"
                                           ButtonSize="56"
                                           SemanticProperties.Description="{x:Static strings:AppStrings.MoveRightDescription}" />
                </Border>
            </HorizontalStackLayout>

            <!-- Undo (at right edge of screen) -->
            <Border WidthRequest="56"
                    HeightRequest="56"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 28"
                    Background="{AppThemeBinding Light={StaticResource ModalBackgroundLight}, Dark={StaticResource ModalBackgroundDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                    IsVisible="{Binding IsUndoButtonVisible}"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    components:LiquidGlass.EffectType="Clear"
                    components:LiquidGlass.CornerRadius="28">
                <components:IconButton x:Name="UndoButton"
                                       Icon="↩"
                                       ButtonText=""
                                       Command="{Binding UndoCommand}"
                                       IsButtonEnabled="{Binding CanUndo}"
                                       ButtonSize="56"
                                       SemanticProperties.Description="{x:Static strings:AppStrings.UndoDescription}" />
            </Border>
        </Grid>

        </Grid>

        <!-- Victory warp overlay - spans entire page, behind other content when inactive -->
        <components:LoopingLottieOverlay
            x:Name="VictoryWarpOverlay"
            AssetName="victory_warp.json"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            IsVisible="False"
            ZIndex="100"
            Opacity="0"
            InputTransparent="True" />

        <!-- Victory modal overlay - sits above the board when visible -->
        <components:VictoryModalOverlay
            x:Name="VictoryModalOverlay"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            ZIndex="101" />
    </Grid>
</ContentPage>
