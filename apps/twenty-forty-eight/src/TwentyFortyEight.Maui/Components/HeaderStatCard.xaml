<?xml version="1.0" encoding="utf-8" ?>
<ContentView
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  xmlns:local="clr-namespace:TwentyFortyEight.Maui.Components"
  xmlns:converters="clr-namespace:TwentyFortyEight.Maui.Converters"
  x:Class="TwentyFortyEight.Maui.Components.HeaderStatCard"
  x:DataType="local:HeaderStatCard"
  x:Name="this"
>
  <ContentView.Resources>
    <converters:ValueLengthToFontSizeConverter
      x:Key="ValueLengthToFontSizeConverter"
      BaseFontSize="24"
      MinFontSize="14"
      ScaleThreshold="4"
    />
  </ContentView.Resources>

  <!-- Score is the filled scoreboard; Best is the quieter outlined companion. -->
  <Border
    MinimumWidthRequest="96"
    MinimumHeightRequest="60"
    Padding="14,8"
    StrokeShape="RoundRectangle 12"
    StrokeThickness="1.5"
    Stroke="{AppThemeBinding Light={StaticResource GameCardOutlineLight}, Dark={StaticResource GameCardOutlineDark}}"
    Background="Transparent"
  >
    <Border.Triggers>
      <DataTrigger
        TargetType="Border"
        Binding="{Binding IsEmphasized, Source={x:Reference this}}"
        Value="True"
      >
        <Setter Property="StrokeThickness" Value="0" />
        <Setter
          Property="Background"
          Value="{AppThemeBinding Light={StaticResource GameScoreFillLight}, Dark={StaticResource GameScoreFillDark}}"
        />
      </DataTrigger>
    </Border.Triggers>
    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
      <Label
        Text="{Binding Title, Source={x:Reference this}}"
        FontSize="11"
        FontAttributes="Bold"
        CharacterSpacing="1.2"
        TextColor="{AppThemeBinding Light={StaticResource GameMutedInkLight}, Dark={StaticResource GameMutedInkDark}}"
        HorizontalOptions="Center"
        LineBreakMode="NoWrap"
      >
        <Label.Triggers>
          <DataTrigger
            TargetType="Label"
            Binding="{Binding IsEmphasized, Source={x:Reference this}}"
            Value="True"
          >
            <Setter
              Property="TextColor"
              Value="{AppThemeBinding Light={StaticResource GameScoreLabelLight}, Dark={StaticResource GameScoreLabelDark}}"
            />
          </DataTrigger>
        </Label.Triggers>
      </Label>
      <Label
        Text="{Binding Value, Source={x:Reference this}}"
        FontSize="{Binding Value, Source={x:Reference this}, Converter={StaticResource ValueLengthToFontSizeConverter}}"
        FontAttributes="Bold"
        TextColor="{AppThemeBinding Light={StaticResource GameInkLight}, Dark={StaticResource GameInkDark}}"
        HorizontalOptions="Center"
        LineBreakMode="NoWrap"
        SemanticProperties.Description="{Binding ValueDescription, Source={x:Reference this}}"
      >
        <Label.Triggers>
          <DataTrigger
            TargetType="Label"
            Binding="{Binding IsEmphasized, Source={x:Reference this}}"
            Value="True"
          >
            <Setter Property="TextColor" Value="White" />
          </DataTrigger>
        </Label.Triggers>
      </Label>
    </VerticalStackLayout>
  </Border>
</ContentView>
