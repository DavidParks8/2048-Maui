<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
>
  <Style TargetType="ContentPage">
    <Setter Property="Background" Value="{StaticResource PageBackground}" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style TargetType="Label">
    <Setter Property="FontAutoScalingEnabled" Value="True" />
    <Setter Property="TextColor" Value="{StaticResource White}" />
  </Style>
  <Style TargetType="Button">
    <Setter Property="Background" Value="{StaticResource Surface2}" />
    <Setter Property="TextColor" Value="{StaticResource White}" />
    <Setter Property="FontAttributes" Value="Bold" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="MinimumHeightRequest" Value="60" />
    <Setter Property="Padding" Value="18,12" />
    <Setter Property="FontAutoScalingEnabled" Value="True" />
  </Style>
  <Style TargetType="Entry">
    <Setter Property="Background" Value="{StaticResource Surface}" />
    <Setter Property="TextColor" Value="{StaticResource White}" />
    <Setter Property="PlaceholderColor" Value="{StaticResource TextTertiary}" />
    <Setter Property="FontSize" Value="21" />
    <Setter Property="FontAutoScalingEnabled" Value="True" />
    <Setter Property="MinimumHeightRequest" Value="70" />
    <Setter Property="ClearButtonVisibility" Value="Never" />
  </Style>
</ResourceDictionary>
