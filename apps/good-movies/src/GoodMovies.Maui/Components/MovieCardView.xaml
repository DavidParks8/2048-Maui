<?xml version="1.0" encoding="utf-8" ?>
<ContentView
  x:Class="GoodMovies.Maui.Components.MovieCardView"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:local="clr-namespace:GoodMovies.Maui.Components"
  xmlns:strings="clr-namespace:GoodMovies.Maui.Resources.Strings"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  x:DataType="local:MovieCardView"
  x:Name="Root"
>
  <Grid x:Name="CardRoot" RowDefinitions="*">
    <Border
      x:Name="CardBorder"
      Padding="{OnIdiom Phone=14, Default=16}"
      AutomationId="{Binding Card, Converter={StaticResource CardAutomationIdConverter}, Source={x:Reference Root}}"
      Background="{StaticResource Surface}"
      SemanticProperties.Description="{Binding Card, Converter={StaticResource CardAccessibilityConverter}, Source={x:Reference Root}}"
      SemanticProperties.Hint="{x:Static strings:AppStrings.OpenMovieHint}"
      Stroke="Transparent"
      StrokeShape="RoundRectangle 24"
      StrokeThickness="0"
    >
      <Border.Shadow>
        <Shadow Brush="#66000000" Offset="0,6" Opacity="0.45" Radius="0" />
      </Border.Shadow>
      <Border.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnOpenTapped" />
      </Border.GestureRecognizers>
      <Grid
        x:Name="CardGrid"
        ColumnSpacing="{OnIdiom Phone=12, Default=16}"
        RowDefinitions="*"
        RowSpacing="0"
      >
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="{OnIdiom Phone=88, Default=120}" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="{OnIdiom Phone=64, Default=72}" />
        </Grid.ColumnDefinitions>

        <Border
          x:Name="PosterBorder"
          Grid.Column="0"
          AutomationProperties.IsInAccessibleTree="False"
          Background="{StaticResource Surface2}"
          HeightRequest="{OnIdiom Phone=132, Default=180}"
          InputTransparent="True"
          Stroke="Transparent"
          StrokeShape="RoundRectangle 16"
          StrokeThickness="0"
          WidthRequest="{OnIdiom Phone=88, Default=120}"
        >
          <Grid InputTransparent="True" RowDefinitions="*,Auto" RowSpacing="0">
            <Label
              Grid.Row="0"
              AutomationProperties.IsInAccessibleTree="False"
              FontAutoScalingEnabled="True"
              FontSize="32"
              HorizontalOptions="Center"
              InputTransparent="True"
              Text="{x:Static strings:AppStrings.MovieIcon}"
              TextColor="{StaticResource Accent}"
              VerticalOptions="Center"
              VerticalTextAlignment="Center"
            />
            <Label
              Grid.Row="1"
              Margin="6,0,6,8"
              FontAutoScalingEnabled="True"
              FontAttributes="Bold"
              FontSize="14"
              HorizontalTextAlignment="Center"
              InputTransparent="True"
              LineBreakMode="TailTruncation"
              MaxLines="2"
              Text="{Binding Card.Title, Source={x:Reference Root}}"
              TextColor="{StaticResource White}"
            />
            <Image
              Grid.Row="0"
              Grid.RowSpan="2"
              Aspect="AspectFill"
              InputTransparent="True"
              IsVisible="{Binding Card.PosterSource, Converter={StaticResource StringVisibilityConverter}, Source={x:Reference Root}}"
              Source="{Binding Card.PosterSource, Converter={StaticResource PosterImageSourceConverter}, Source={x:Reference Root}}"
            />
          </Grid>
        </Border>

        <Grid
          x:Name="InfoGrid"
          Grid.Column="1"
          AutomationProperties.IsInAccessibleTree="False"
          InputTransparent="True"
          RowDefinitions="Auto,Auto,Auto"
          RowSpacing="9"
          VerticalOptions="Center"
        >
          <Label
            Grid.Row="0"
            FontAutoScalingEnabled="True"
            FontAttributes="Bold"
            FontSize="27"
            LineBreakMode="TailTruncation"
            MaxLines="3"
            Text="{Binding Card.Title, Source={x:Reference Root}}"
            TextColor="{StaticResource White}"
          />
          <Label
            Grid.Row="1"
            FontAutoScalingEnabled="True"
            FontAttributes="Bold"
            FontSize="21"
            LineBreakMode="WordWrap"
            MaxLines="2"
            Text="{Binding Card, Converter={StaticResource CardStatusConverter}, Source={x:Reference Root}}"
            TextColor="{StaticResource Accent}"
          />
          <FlexLayout
            Grid.Row="2"
            AlignItems="Start"
            Direction="Row"
            InputTransparent="True"
            Wrap="Wrap"
          >
            <Border
              Margin="0,0,8,6"
              Padding="10,4"
              Background="{StaticResource Accent}"
              Stroke="Transparent"
              StrokeShape="RoundRectangle 10"
              StrokeThickness="0"
            >
              <Label
                FontAutoScalingEnabled="True"
                FontAttributes="Bold"
                FontSize="16"
                Text="{Binding Card.Rating, Converter={StaticResource RatingLabelConverter}, Source={x:Reference Root}}"
                TextColor="{StaticResource PageBackground}"
              />
            </Border>
            <Border
              Margin="0,0,0,6"
              Padding="10,4"
              Background="{StaticResource Surface2}"
              Stroke="{StaticResource AccentMuted}"
              StrokeShape="RoundRectangle 10"
              StrokeThickness="1"
            >
              <HorizontalStackLayout Spacing="6">
                <Label
                  AutomationProperties.IsInAccessibleTree="False"
                  FontAutoScalingEnabled="True"
                  FontSize="16"
                  Text="{Binding Card.KindIcon, Source={x:Reference Root}}"
                />
                <Label
                  FontAutoScalingEnabled="True"
                  FontSize="16"
                  LineBreakMode="TailTruncation"
                  MaxLines="1"
                  Text="{Binding Card.Kind, Converter={StaticResource KindLabelConverter}, Source={x:Reference Root}}"
                  TextColor="{StaticResource White}"
                />
              </HorizontalStackLayout>
            </Border>
          </FlexLayout>
        </Grid>
      </Grid>
    </Border>

    <Button
      x:Name="FavoriteButton"
      Margin="{OnIdiom Phone='0,0,14,0', Default='0,0,16,0'}"
      Padding="0"
      AutomationId="{Binding Card, Converter={StaticResource CardFavoriteAutomationIdConverter}, Source={x:Reference Root}}"
      Background="{StaticResource Surface2}"
      BorderWidth="0"
      Command="{Binding Card.ToggleFavoriteCommand, Source={x:Reference Root}}"
      CornerRadius="20"
      FontAttributes="Bold"
      FontAutoScalingEnabled="False"
      FontSize="{OnIdiom Phone=27, Default=30}"
      HeightRequest="{OnIdiom Phone=60, Default=68}"
      HorizontalOptions="End"
      MinimumHeightRequest="{OnIdiom Phone=60, Default=68}"
      MinimumWidthRequest="{OnIdiom Phone=60, Default=68}"
      SemanticProperties.Description="{Binding FavoriteAccessibilityLabel, Source={x:Reference Root}}"
      SemanticProperties.Hint="{Binding FavoriteAccessibilityHint, Source={x:Reference Root}}"
      Text="{Binding Card.IsFavorite, Converter={StaticResource HeartGlyphConverter}, Source={x:Reference Root}}"
      TextColor="{StaticResource Accent}"
      VerticalOptions="Center"
      WidthRequest="{OnIdiom Phone=60, Default=68}"
      ZIndex="2"
    >
      <Button.Triggers>
        <DataTrigger
          Binding="{Binding Card.IsFavorite, Source={x:Reference Root}}"
          TargetType="Button"
          Value="True"
        >
          <Setter Property="Background" Value="{StaticResource Accent}" />
          <Setter Property="TextColor" Value="{StaticResource PageBackground}" />
        </DataTrigger>
      </Button.Triggers>
    </Button>
  </Grid>
</ContentView>
