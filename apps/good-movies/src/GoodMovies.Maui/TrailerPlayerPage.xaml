<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
  x:Class="GoodMovies.Maui.TrailerPlayerPage"
  xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
  xmlns:controls="clr-namespace:GoodMovies.Maui.Controls"
  xmlns:local="clr-namespace:GoodMovies.Maui"
  xmlns:strings="clr-namespace:GoodMovies.Maui.Resources.Strings"
  xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
  x:DataType="local:TrailerPlayerPage"
  AutomationId="TrailerPlayerPage"
  Background="{StaticResource PageBackground}"
  SafeAreaEdges="All"
  Shell.NavBarIsVisible="False"
>
  <Grid Padding="24,18,24,24" RowDefinitions="Auto,*" RowSpacing="18">
    <Grid Grid.Row="0" Margin="0,0,130,0">
      <Label
        FontAttributes="Bold"
        FontAutoScalingEnabled="True"
        FontSize="32"
        LineBreakMode="TailTruncation"
        MaxLines="1"
        Text="{x:Static strings:AppStrings.TrailerPlayerTitle}"
        TextColor="{StaticResource White}"
        VerticalOptions="Center"
      />
    </Grid>

    <Border
      x:Name="PlayerFrame"
      Grid.Row="1"
      Background="{StaticResource Surface}"
      Stroke="{StaticResource Surface2}"
      StrokeShape="RoundRectangle 24"
      StrokeThickness="3"
    >
      <Grid>
        <controls:TrailerPlayerView
          x:Name="TrailerWebView"
          AutomationId="TrailerPlayerWebView"
          LoadFailed="OnPlayerLoadFailed"
          LoadStarted="OnPlayerLoadStarted"
          LoadSucceeded="OnPlayerLoadSucceeded"
        />

        <Grid
          x:Name="LoadingOverlay"
          Padding="32"
          AutomationId="TrailerPlayerLoading"
          Background="{StaticResource Surface}"
        >
          <VerticalStackLayout HorizontalOptions="Center" Spacing="18" VerticalOptions="Center">
            <ActivityIndicator
              Color="{StaticResource Accent}"
              HeightRequest="54"
              IsRunning="True"
              WidthRequest="54"
            />
            <Label
              FontAttributes="Bold"
              FontAutoScalingEnabled="True"
              FontSize="27"
              HorizontalTextAlignment="Center"
              Text="{x:Static strings:AppStrings.TrailerPlayerLoading}"
              TextColor="{StaticResource White}"
            />
          </VerticalStackLayout>
        </Grid>

        <Grid
          x:Name="ErrorOverlay"
          Padding="32"
          AutomationId="TrailerPlayerError"
          Background="{StaticResource Surface}"
          IsVisible="False"
        >
          <VerticalStackLayout
            HorizontalOptions="Center"
            MaximumWidthRequest="560"
            Spacing="16"
            VerticalOptions="Center"
          >
            <Label
              AutomationProperties.IsInAccessibleTree="False"
              FontAutoScalingEnabled="True"
              FontSize="58"
              HorizontalOptions="Center"
              Text="⚠"
              TextColor="{StaticResource Accent}"
            />
            <Label
              FontAttributes="Bold"
              FontAutoScalingEnabled="True"
              FontSize="27"
              HorizontalTextAlignment="Center"
              Text="{x:Static strings:AppStrings.TrailerPlayerErrorTitle}"
              TextColor="{StaticResource White}"
            />
            <Label
              FontAutoScalingEnabled="True"
              FontSize="21"
              HorizontalTextAlignment="Center"
              LineHeight="1.6"
              Text="{x:Static strings:AppStrings.TrailerPlayerErrorMessage}"
              TextColor="{StaticResource TextSecondary}"
            />
            <Button
              Padding="26,12"
              AutomationId="TrailerPlayerRetryButton"
              Background="{StaticResource Accent}"
              Clicked="OnRetryClicked"
              FontAttributes="Bold"
              FontAutoScalingEnabled="True"
              FontSize="21"
              HeightRequest="64"
              SemanticProperties.Description="{x:Static strings:AppStrings.Retry}"
              Text="{x:Static strings:AppStrings.Retry}"
              TextColor="{StaticResource PageBackground}"
            />
          </VerticalStackLayout>
        </Grid>
      </Grid>
    </Border>
    <Button
      x:Name="DoneButton"
      Grid.Row="0"
      Padding="24,12"
      AutomationId="TrailerPlayerDoneButton"
      Background="{StaticResource Accent}"
      FontAttributes="Bold"
      FontAutoScalingEnabled="True"
      FontSize="21"
      HeightRequest="64"
      HorizontalOptions="End"
      MinimumHeightRequest="64"
      SemanticProperties.Description="{x:Static strings:AppStrings.TrailerPlayerDone}"
      Text="{x:Static strings:AppStrings.TrailerPlayerDone}"
      TextColor="{StaticResource PageBackground}"
      VerticalOptions="Center"
      ZIndex="100"
    />
  </Grid>
</ContentPage>
